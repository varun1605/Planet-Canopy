# Sanity (CMS) — public values, safe to expose in browser bundle
# Find these at https://sanity.io/manage → project → Settings
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Sanity write token — server-only, NEVER prefix with NEXT_PUBLIC_
# Generate at https://sanity.io/manage → project → API → Tokens
# Permission: Editor (write access required for /api/enquiry route)
SANITY_API_TOKEN=

# Resend (email notifications)
# Generate at https://resend.com/api-keys (permission: Sending access)
RESEND_API_KEY=

# Email address that receives enquiry notifications
OWNER_EMAIL=

# From-address for outbound emails.
# - Sandbox (testing only): "Planet Canopy <onboarding@resend.dev>"
#   ⚠ Sandbox can ONLY send to the email you signed up to Resend with.
# - Production: "Planet Canopy <bookings@yourdomain.com>"
#   Requires verifying the domain in Resend → Domains first.
RESEND_FROM_EMAIL=Planet Canopy <onboarding@resend.dev>
